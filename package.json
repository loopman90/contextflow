{
  "name": "contextflow",
  "version": "0.1.4",
  "private": true,
  "description": "ContextFlow Obsidian plugin",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && NODE_ENV=production node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
